# =========================================================================
# 1. NÚCLEO DE LA APLICACIÓN (CORE & LOGS)
# =========================================================================
APP_NAME="Gestión de Incidencias"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# EN PRODUCCIÓN DOCKER: Cambia esto por tu dominio (ej. https://tudominio.com)
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# =========================================================================
# 2. BASE DE DATOS (POSTGRESQL)
# =========================================================================
DB_CONNECTION=pgsql
# EN DOCKER: usa el nombre del contenedor (sistema_postgres). EN LOCAL con iniciar.sh: usa 127.0.0.1
DB_HOST=sistema_postgres
DB_PORT=5432
DB_DATABASE=gestion_incidencias
DB_USERNAME=angeltux
DB_PASSWORD=password_segura_upse

# =========================================================================
# 3. DRIVERS Y ALMACENAMIENTO (SESIONES, CACHÉ & COLAS)
# =========================================================================
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# EN PRODUCCIÓN DOCKER: Puedes usar .tudominio.com (con punto inicial)
SESSION_DOMAIN=null

# =========================================================================
# 4. SEGURIDAD Y CORS (LARAVEL SANCTUM)
# =========================================================================
# VITAL: Lista de dominios que Sanctum aceptará para autenticación SPA (sin http/https)
# Agrega tu dominio de producción aquí separados por coma
SANCTUM_STATEFUL_DOMAINS="localhost:3005,localhost:3006,127.0.0.1:3005,127.0.0.1:3006"

# =========================================================================
# 5. WEBSOCKETS (LARAVEL REVERB)
# =========================================================================
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Configuración del servidor Reverb (Cómo escucha dentro de Docker/Local)
REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8080

# Cómo se conecta el backend de Laravel para emitir eventos (Broadcasting)
# EN DOCKER: Debe ser el nombre del servicio (sistema_reverb) o 127.0.0.1 en un mismo pod
# EN LOCAL PHP: Usa 127.0.0.1
REVERB_HOST="sistema_reverb"
REVERB_PORT=8080
REVERB_SCHEME=http

# =========================================================================
# 6. FRONTEND (VARIABLES VITE PARA CLIENTE JS)
# =========================================================================
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"

# EN PRODUCCIÓN DOCKER: VITE_REVERB_HOST="tudominio.com" | PORT=443 | SCHEME="https"
# EN LOCAL (con iniciar.sh cambia VITE_REVERB_PORT a 8083 y REVERB_PORT a 8083):
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# =========================================================================
# 7. SERVICIOS SECUNDARIOS (CORREO & REDIS/MEMCACHED)
# =========================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@incidencias.com"
MAIL_FROM_NAME="${APP_NAME}"

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
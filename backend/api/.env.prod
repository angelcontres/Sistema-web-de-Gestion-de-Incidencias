# =========================================================================
# 1. NÚCLEO DE LA APLICACIÓN (CORE & LOGS)
# =========================================================================
APP_NAME="Gestión de Incidencias"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://alertcity.dihm-muertos.site

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# =========================================================================
# 2. BASE DE DATOS (POSTGRESQL)
# =========================================================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gestion_incidencias
DB_USERNAME=angeltux
DB_PASSWORD=password_segura_upse

# =========================================================================
# 3. DRIVERS Y ALMACENAMIENTO (SESIONES, CACHÉ & COLAS)
# =========================================================================
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.alertcity.dihm-muertos.site

# =========================================================================
# 4. SEGURIDAD Y CORS (LARAVEL SANCTUM)
# =========================================================================
SANCTUM_STATEFUL_DOMAINS="alertcity.dihm-muertos.site"

# =========================================================================
# 5. WEBSOCKETS (LARAVEL REVERB)
# =========================================================================
REVERB_APP_ID=10001
REVERB_APP_KEY=my-app-key-prod
REVERB_APP_SECRET=tu_secreto_prod

REVERB_SERVER_HOST="0.0.0.0"
REVERB_SERVER_PORT=8080

REVERB_HOST="laravel-reverb"
REVERB_PORT=8080
REVERB_SCHEME=http

# =========================================================================
# 6. FRONTEND (VARIABLES VITE PARA CLIENTE JS)
# =========================================================================
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="alertcity.dihm-muertos.site"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# =========================================================================
# 7. SERVICIOS SECUNDARIOS (CORREO & REDIS/MEMCACHED)
# =========================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@alertcity.dihm-muertos.site"
MAIL_FROM_NAME="${APP_NAME}"

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
